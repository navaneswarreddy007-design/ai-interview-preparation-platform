# ==============================================================================
# Production Environment Configuration
# ==============================================================================

# Network binding
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# Security Secret Key
SECRET_KEY=change_this_to_a_random_cryptographic_key_in_production_2026

# CORS Configuration (allowed origins separated by comma, or * for any origin)
CORS_ORIGINS=*

# Storage Paths (mount persistent volume here)
DATABASE_PATH=interview_prep.db
UPLOAD_FOLDER=uploads

# External LLM Providers (Optional - leave empty for Demo / Deterministic mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
