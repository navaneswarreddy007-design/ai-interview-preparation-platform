# ==============================================================================
# PrepForge Frontend Environment Configuration
# ==============================================================================

# For separate frontend deployments (e.g., Vercel, Netlify, GitHub Pages):
# Set this to the public URL of your deployed backend Flask server.
# Example: https://prepforge-api.onrender.com or https://api.yourdomain.com
VITE_API_BASE_URL=

# Note: If deploying unified (frontend static files served by Flask/Gunicorn on the same domain),
# leave VITE_API_BASE_URL blank. The app will automatically use relative '/api' calls.
